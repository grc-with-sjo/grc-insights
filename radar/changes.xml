---
layout: null
permalink: /radar/changes.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>GRC Insights · Regulation Radar changes</title>
  <link href="{{ '/radar/' | absolute_url }}"/>
  <link rel="self" href="{{ '/radar/changes.xml' | absolute_url }}"/>
  <id>{{ '/radar/changes.xml' | absolute_url }}</id>
  <updated>{% assign newest = site.data.radar_changes | first %}{{ newest.date | date_to_xmlschema }}</updated>
  <author><name>{{ site.author.name }}</name></author>
  {% for c in site.data.radar_changes limit: 50 %}{% assign row = site.data.tracker | where: 'id', c.id | first %}
  <entry>
    <title>{{ row.name | xml_escape }}</title>
    <link href="{{ '/radar/' | absolute_url }}#{{ c.id }}"/>
    <id>{{ '/radar/' | absolute_url }}#{{ c.id }}-{{ c.date }}-{{ forloop.index }}</id>
    <updated>{{ c.date | date_to_xmlschema }}</updated>
    <summary>{{ c.change | xml_escape }} Source: {{ c.source | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>
